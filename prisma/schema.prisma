datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

enum Role {
  SUPER_ADMIN
  REVIEWER
  HR_AGENT
  JURY_MEMBER
  COMMISSION
  CANDIDATE
}

enum ApplicationStatus {
  DRAFT
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  ORAL_TEST
  FINAL_LIST
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum Gender {
  MALE
  FEMALE
}

enum StudyLevel {
  BAC
  BAC_PLUS_2
  LICENCE
  MAITRISE
  MASTER
  DOCTORAT
}

// Candidate track a job belongs to.
// ACADEMIC -> diploma required (engineers, administrators, technicians)
// MANUAL   -> no diploma required, declared education level instead
//           (maintenance, multi-skilled workers, cleaners)
enum CandidateProfile {
  ACADEMIC
  MANUAL
}

// Education level declared by MANUAL candidates, used for eligibility
// and as the base of the dossier score.
enum EduLevel {
  NONE
  PRIMARY
  MIDDLE
  SECONDARY
  VOCATIONAL
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  password     String
  name         String
  role         Role     @default(REVIEWER)
  isActive     Boolean  @default(true)
  lastLogin    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs    AuditLog[]

  @@map("admins")
}

model RolePermission {
  id          String   @id @default(cuid())
  role        Role     @unique
  permissions Json
  updatedAt   DateTime @updatedAt

  @@map("role_permissions")
}

model Candidate {
  id                String   @id @default(cuid())
  email             String   @unique
  password          String
  isEmailVerified   Boolean  @default(false)
  verificationCode String?
  verificationExpiry DateTime?
  smsOptIn          Boolean  @default(true)
  
  fullName          String
  cin               String   @unique
  dateOfBirth      DateTime
  gender            Gender
  phone             String
  address           String?
  governorate       String
  delegation        String
  
  hasExperience     Boolean  @default(false)
  
  currentStep       Int      @default(1)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  experiences       Experience[]
  diplomas          Diploma[]
  applications      Application[]
  notifications     Notification[]
  documents         Document[]
  auditLogs         AuditLog[]
  examResults       ExamResult[]

  @@index([governorate])
  @@index([fullName])
  @@map("candidates")
}

model Experience {
  id            String    @id @default(cuid())
  candidateId   String
  company       String
  position      String
  startDate     DateTime
  endDate       DateTime?
  isCurrent     Boolean   @default(false)
  description   String?
  
  candidate     Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("experiences")
}

model Diploma {
  id              String      @id @default(cuid())
  candidateId     String
  studyLevel      StudyLevel
  diploma         String
  institution     String
  grade           String
  graduationYear  Int
  
  candidate       Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("diplomas")
}

enum ExamType {
  WRITTEN
  ORAL
  PRACTICAL
  SPORTS
}

enum SessionType {
  MAIN
  RESIT
}

model Job {
  id              String    @id @default(cuid())
  code            String    @unique
  titleAr         String
  titleFr         String
  descriptionAr   String    @db.Text
  descriptionFr   String    @db.Text
  location        String
  jobType         String
  openings        Int
  deadline        DateTime
  status          JobStatus @default(DRAFT)
  profile         CandidateProfile @default(ACADEMIC)
  minEduLevel     EduLevel  @default(SECONDARY)
  dossierWeight   Float     @default(70)
  oralWeight      Float     @default(30)
  requiredDocs    String    @db.Text
  exclusionConditions String? @db.Text
  
  pdfUrl          String?
  imageUrl        String?

  resultsPublished   Boolean  @default(false)
  resultsArchived    Boolean  @default(false)
  resultsPublishedAt DateTime?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  applications    Application[]
  scoringCriteria ScoredCriteria[]
  convocationTemplate ConvocationTemplate?
  exams           Exam[]

  @@index([status])
  @@index([deadline])
  @@index([status, deadline])
  @@index([profile])
  @@index([resultsPublished])
  @@map("jobs")
}

model Room {
  id        String   @id @default(cuid())
  name      String
  capacity  Int
  location  String?
  equipment String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions  ExamSession[]

  @@map("rooms")
}

model Exam {
  id          String   @id @default(cuid())
  titleAr     String
  titleFr     String
  jobId       String
  type        ExamType
  coefficient Float    @default(1)
  duration    Int?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  job         Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sessions    ExamSession[]

  @@index([jobId])
  @@map("exams")
}

model ExamSession {
  id            String      @id @default(cuid())
  examId        String
  roomId        String?
  name          String?
  date          DateTime
  endDate       DateTime?
  startTime     String
  endTime       String
  type          SessionType @default(MAIN)
  maxCandidates Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  exam          Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  room          Room?         @relation(fields: [roomId], references: [id], onDelete: SetNull)
  results       ExamResult[]

  @@index([examId])
  @@index([roomId])
  @@index([date])
  @@map("exam_sessions")
}

model ExamResult {
  id          String    @id @default(cuid())
  sessionId   String
  candidateId String
  score       Float?
  present     Boolean   @default(true)
  gradedBy    String?
  gradedAt    DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  session     ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  candidate   Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([sessionId, candidateId])
  @@index([sessionId])
  @@index([candidateId])
  @@map("exam_results")
}

model Application {
  id              String            @id @default(cuid())
  candidateId     String
  jobId           String
  status          ApplicationStatus @default(PENDING)
  
  personalInfo    Json?
  academicInfo    Json?
  experienceInfo  Json?
  eduLevel        EduLevel?
  
  totalScore      Float?
  rank             Int?
  
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewedBy      String?
  convocationPath String?
  convocationSentAt DateTime?
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  candidate       Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job             Job               @relation(fields: [jobId], references: [id])
  documents       Document[]
  scores          Score[]
  statusHistory   StatusHistory[]

  @@unique([candidateId, jobId])
  @@index([status])
  @@index([candidateId, status])
  @@index([jobId, status])
  @@map("applications")
}

model Document {
  id            String        @id @default(cuid())
  candidateId   String?
  applicationId String?
  type          String
  fileName      String
  fileUrl       String
  fileSize      Int
  mimeType      String
  data          Bytes

  uploadedAt    DateTime      @default(now())

  candidate     Candidate?    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  application   Application?  @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([type])
  @@index([candidateId])
  @@index([applicationId])
  @@map("documents")
}

model ScoredCriteria {
  id        String @id @default(cuid())
  jobId     String
  name      String
  weight    Float
  
  job       Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  scores    Score[]

  @@map("scored_criteria")
}

model Score {
  id          String         @id @default(cuid())
  applicationId String
  criteriaId  String
  value       Float
  
  application Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  criteria    ScoredCriteria @relation(fields: [criteriaId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([applicationId, criteriaId])
  @@map("scores")
}

model StatusHistory {
  id            String            @id @default(cuid())
  applicationId String
  status        ApplicationStatus
  note          String?
  changedBy     String
  changedAt     DateTime          @default(now())

  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("status_history")
}

model Notification {
  id          String   @id @default(cuid())
  candidateId String?
  type        String
  channel     String
  subject     String
  body        String
  sentAt      DateTime @default(now())
  status      String
  error       String?

  candidate   Candidate? @relation(fields: [candidateId], references: [id])

  @@index([type])
  @@index([status])
  @@index([sentAt])
  @@map("notifications")
}

model ConvocationTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  titleAr     String
  titleFr     String
  headerAr    String   @default("")
  headerFr    String   @default("")
  footerAr    String?  @db.Text
  footerFr    String?  @db.Text
  logoUrl     String?
  fields      Json     @default("[]")
  isDefault   Boolean  @default(false)
  jobId       String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  job         Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@map("convocation_templates")
}

model AuditLog {
  id          String   @id @default(cuid())
  adminId     String?
  candidateId String?
  action      String
  entity      String
  entityId    String
  details     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  admin       Admin?    @relation(fields: [adminId], references: [id])
  candidate   Candidate? @relation(fields: [candidateId], references: [id])

  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}