# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database
DATABASE_URL="mysql://root:@localhost:3306/promosport"

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32

# Email (Nodemailer SMTP) — use a Gmail App Password or your provider
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="PROMOSPORT <noreply@promosport.tn>"
# Never send mail; log verification codes to the server console instead
# SKIP_EMAIL_SEND=true

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5